# === MongoDB ===
MONGO_URL="mongodb://localhost:27017"
DB_NAME="roteira"

# === CORS ===
CORS_ORIGINS="*"

# === LLM (Emergent Universal Key - already provisioned for you) ===
# Substitua pela sua chave se desejar. A chave universal Emergent funciona
# com OpenAI (GPT-5.6), Anthropic (Claude Sonnet 5) e Gemini 3.1 Pro.
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna

# === Stripe (Assinatura Premium R$5/mês) ===
# STRIPE_API_KEY=sk_test_emergent  ->  chave sandbox pré-injetada
# Para produção: reivindique sua sandbox seguindo o link do painel Emergent.
STRIPE_API_KEY=sk_test_emergent
# PIX (Brasil): ative apenas depois de habilitar PIX no Stripe Dashboard
# (Settings → Payment methods → PIX). Requer conta Stripe brasileira reivindicada.
STRIPE_ENABLE_PIX=false
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_MODE=test

# === Admin ===
ADMIN_EMAIL=admin@roteira.com
ADMIN_PASSWORD=troque-esta-senha

# === Segurança ===
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# === Limites de plano (ajuste livremente) ===
FREE_MONTHLY_LIMIT=5
PREMIUM_MONTHLY_LIMIT=100
PREMIUM_PRICE_BRL=5
PREMIUM_DAYS=30
